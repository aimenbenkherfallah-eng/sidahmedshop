# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sidahmedshop?retryWrites=true&w=majority

# Optionnel : force des resolveurs DNS (utile si le DNS du PC bloque les requêtes SRV de Node)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Cloudinary (persistent image storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_COOKIE_EXPIRES_IN=7d

# ---- Admin (seeded once via `npm run seed`) ----
ADMIN_USERNAME=sidahmed
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# ---- Meta Conversions API (server-side events) ----
META_PIXEL_ID=
META_ACCESS_TOKEN=

# ---- TikTok Events API (server-side events) ----
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# ---- Cloudflare Turnstile (bot protection for COD forms) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
